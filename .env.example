# Application mode
# Set to true to make the modbus reader generate dummy data instead of talking to real power meters.
# This only affects the modbus polling layer; the rest of the app (API, cron aggregations) stays the same.
DUMMY_MODE=false

# Seconds between each full polling cycle in read_modbus.py.
MODBUS_READ_INTERVAL=60

# Maximum concurrent devices polled in one cycle.
MODBUS_MAX_WORKERS=60

# Database settings (override configuration/database.ini if needed)
# DB_HOST=db
# DB_NAME=mpm_dummy
# DB_USER=mpm_user
# DB_PASSWORD=mpm_password
# DB_PORT=5432
