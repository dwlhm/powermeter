# Stage 1: Build the Vite frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Allow docker-compose to inject the backend URL at build time.
# Empty value = relative URLs, which works with the nginx reverse proxy.
ARG VITE_BACKEND_URL=

# Install pnpm for dependency management
RUN npm install -g pnpm

# Copy package files and install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install

# Copy the rest of the frontend code
COPY . .

# Overwrite .env so Vite bakes the configured backend URL into the build.
RUN echo "VITE_BACKEND_URL=${VITE_BACKEND_URL}" > .env

# Build production assets
RUN pnpm run build

# Stage 2: Serve the built app with Nginx over HTTP (80) and HTTPS (443)
FROM nginx:alpine

# Copy the built static files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# SSL certificates are mounted at runtime via docker-compose.
# Ensure the directory exists so nginx starts even if certs are mounted.
RUN mkdir -p /etc/nginx/ssl

# Expose standard HTTP and HTTPS ports
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
